# Free key, no credit card: https://console.groq.com/keys
GROQ_API_KEY=paste-your-key-here

# Optional: pick another Groq model (must support tool calling)
# LLM_MODEL=openai/gpt-oss-120b

# Optional: use a different OpenAI-compatible provider instead of Groq
# e.g. Ollama running locally (fully free, no key):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Optional: token limits (save your free quota)
# LLM_MAX_TOKENS=1000   # most tokens per AI reply
# LLM_MAX_STEPS=6       # most AI steps per question in the agent loop
